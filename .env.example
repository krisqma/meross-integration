# Skopiuj do .env i uzupełnij MEROSS_KEY (./dot.sh login zrobi to za Ciebie).
# .env jest w .gitignore — nie commituj klucza.

TZ=Europe/Warsaw

# Broker
MQTT_HOST=mosquitto
MQTT_PORT=1883
HOMIE_PREFIX=homie

# Aplikacja webowa
DB_PATH=/data/gniazdka.db
WEB_PORT=8080

# Meross
MEROSS_KEY=
MEROSS_API_URL=https://iotx-eu.meross.com

# Sieć lokalna (skan w tools/discover.py)
LAN_SUBNET=192.168.1.0/24

# Klucz używany przez atrapy gniazdek w testach
FAKE_DEVICE_KEY=testkey123
